          "product": { "type": "string", "description": "产品编码/名称过滤（可选）。" },
          "doc_type": { "type": "string", "description": "文档类型过滤（可选），如 engineering_drawing。" },
          "limit": { "type": "integer", "default": 50, "minimum": 1, "maximum": 200 }
