          "data": {
            "type": "object",
            "properties": {
              "items": { "type": "array" }
            }
          }
        }
      },
      "execution": "sync"
    },
    {
      "name": "list_m0_entities",
      "description": "按 entity_type 读回 M0 canonical 已批准实体（equipment_master/station_master/worker_master/tooling_master/production_calendar 等），返回 payload_json 列表；用于 M5 资源快照组装。",
      "http": { "method": "GET", "path": "/api/m0/catalog/entities", "timeout_s": 30 },
