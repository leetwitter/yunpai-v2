            "type": "integer"
          },
          "schema_version": {
            "type": "string"
          },
          "base_plan_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "plan_version": {
            "type": "string"
          },
          "scenario_id": {
            "type": "string"
          },
          "lifecycle_status": {
            "type": "string"
          },
          "source_input_hash": {
            "type": "string"
          },
          "affected_lines": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "occurred_at": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          },
          "feedback_ref": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "success",
          "data",
          "errors",
          "trace_id"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "required": [
              "accepted",
              "applied",
              "feedback_ref",
              "status",
              "replayed"
            ],
            "properties": {
              "accepted": {
                "type": "boolean"
              },
              "applied": {
                "type": "boolean"
              },
              "feedback_ref": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "const": "pending_review"
              },
              "replayed": {
                "type": "boolean"
              }
            }
          },
          "errors": {
            "type": "array"
          },
          "trace_id": {
            "type": "string"
          }
        }
      },
      "execution": "sync"
