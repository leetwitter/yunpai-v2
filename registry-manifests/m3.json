            "type": "string",
            "description": "当前 M3 运行返回的不可变采购计划版本 ID。"
          },
          "source_plan_checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "当前 M3 运行返回的原始计划内容 SHA-256。"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "plan_id": {
            "type": "string"
          },
