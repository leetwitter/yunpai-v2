            "type": "string"
          },
          "version_id": {
            "type": "string"
          },
          "source_plan_checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "description": "不可变采购计划快照的创建时间；同一 version_id 重复导出保持不变。"
          },
          "tenant_id": {
            "type": "string"
          },
          "tracking_task_id": {
            "type": "string",
            "description": "从 X-Yunpai-Task-ID 原样校验并返回的业务追踪 ID。"
          },
          "suggestions": {
            "type": "array",
            "description": "采购建议行数组,每条含 item_code/item_name/quantity/unit/supplier_name/required_date/project_code。"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "execution": "sync"
    },
    {
