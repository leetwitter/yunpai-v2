# yunpai-orchestrator v2 环境变量（与 src/yunpai_orchestrator/config.py 严格同源；测试锁定）

# LLM（联调默认本机 27B；生产切 GB10 35B）
QWEN_BASE_URL=http://127.0.0.1:8088/v1
QWEN_MODEL=qwen3.8-27b
QWEN_API_KEY=
QWEN_TIMEOUT_S=45
QWEN_ROUTER_ENABLED=1

# 工具传输（local|http；production 必须 http）
YUNPAI_TOOL_TRANSPORT=local
YUNPAI_HTTP_MODULES=m0,m1,m2,m3,m4,m5
YUNPAI_ENV=sandbox
YUNPAI_LOCAL_M4=0
M0_URL=
M1_URL=
M2_URL=
M3_URL=
M4_URL=
M5_URL=

# 存储（8 库沿用旧文件名；runtime/ 不进 git）
YUNPAI_RUNTIME_DIR=runtime
YUNPAI_RUN_DB=runtime/yunpai-runs.sqlite
YUNPAI_EVOLUTION_DB=runtime/yunpai-evolution.sqlite
YUNPAI_IDENTITY_DB=runtime/yunpai-identity.sqlite
YUNPAI_MANIFEST_DIR=registry-manifests

# 编排与进化
YUNPAI_EVOLUTION_ENABLED=1
YUNPAI_REDLINE_INTERVAL_HOURS=24
YUNPAI_MAX_STEP_RETRIES=2
YUNPAI_KNOWLEDGE_TOP_K=5
YUNPAI_REQUIRE_TRUSTED_PRINCIPAL=0
